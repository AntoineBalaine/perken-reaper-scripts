.{
    .name = .reaper_zig_wrapper,
    .fingerprint = 0xf6e3d32e8a60919d,
    // This is a [Semantic Version](https://semver.org/).
    // In a future version of Zig it will be used for package deduplication.
    .version = "0.0.0",

    // This field is optional.
    // This is currently advisory only; Zig does not yet do anything
    // with this value.
    //.minimum_zig_version = "0.11.0",

    // This field is optional.
    // Each dependency must either provide a `url` and `hash`, or a `path`.
    // `zig build --fetch` can be used to fetch all dependencies of a package, recursively.
    // Once all dependencies are fetched, `zig build` no longer requires
    // internet connectivity.
    .dependencies = .{
        .ini = .{
            .url = "https://github.com/AntoineBalaine/ini/archive/626b556a189d734ce59f6d0b71b8fab80282d1a8.tar.gz",
            .hash = "ini-0.1.0-YCQ9YgKxAAB2BkUapcIR0EpePH6eEt4tLwa-ZHn7fAaL",
        },
        .WDL = .{
            .url = "https://github.com/justinfrankel/WDL/archive/dda0d7519ee9d50d59a39fc1b1a82001416a3dff.tar.gz",
            .hash = "N-V-__8AABIRpgAm7jiz75y7RKLPjxc1ul267ymXVWCtPi94",
        },
        .@"reaper-sdk" = .{
            .url = "https://github.com/justinfrankel/reaper-sdk/archive/6c755b2696ff02a2f5d15d685712d6f2b7e4ed6d.tar.gz",
            .hash = "N-V-__8AACCpGACftICHXjU7H4pNDAP_uEBGNArfMvQgXf-_",
        },
        .zlowcheck = .{
            .url = "https://github.com/AntoineBalaine/zlowcheck/archive/9e4055fcd1fe9d9f87d97dc7dcfcf2d133808e61.tar.gz",
            .hash = "zlowcheck-0.0.0-upaXydGyAwD9-nAAbe3ynJGrbKc0aUxYZIdQCRkljub6",
        },
        // reaziglib lives in the same monorepo, so that a change to it and
        // the extension code using it can land in one commit.
        .reaziglib = .{ .path = "../reaziglib" },
    },
    .paths = .{
        // This makes *all* files, recursively, included in this package. It is generally
        // better to explicitly list the files and directories instead, to insure that
        // fetching from tarballs, file system paths, and version control all result
        // in the same contents hash.
        "",
        // For example...
        //"build.zig",
        //"build.zig.zon",
        //"src",
        //"LICENSE",
        //"README.md",
    },
}
