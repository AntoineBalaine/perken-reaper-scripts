@description Perken VR-09: a CLAP plugin to control the Roland VR-09
@author Perken
@version 0.1.0
@provides
  [linux64] FX/vr09.clap https://github.com/AntoineBalaine/perken-reaper-scripts/releases/download/vr09-v$version/vr09-linux-x86_64.clap
  [linux-aarch64] FX/vr09.clap https://github.com/AntoineBalaine/perken-reaper-scripts/releases/download/vr09-v$version/vr09-linux-aarch64.clap
  [win64] FX/vr09.clap https://github.com/AntoineBalaine/perken-reaper-scripts/releases/download/vr09-v$version/vr09-windows-x86_64.clap
  [darwin64] FX/vr09.clap/Contents/MacOS/vr09 https://github.com/AntoineBalaine/perken-reaper-scripts/releases/download/vr09-v$version/vr09-macos-x86_64
  [darwin64] FX/vr09.clap/Contents/Info.plist https://github.com/AntoineBalaine/perken-reaper-scripts/releases/download/vr09-v$version/vr09-Info.plist
  [darwin-arm64] FX/vr09.clap/Contents/MacOS/vr09 https://github.com/AntoineBalaine/perken-reaper-scripts/releases/download/vr09-v$version/vr09-macos-aarch64
  [darwin-arm64] FX/vr09.clap/Contents/Info.plist https://github.com/AntoineBalaine/perken-reaper-scripts/releases/download/vr09-v$version/vr09-Info.plist
